<footer id="footer" class="footer">
    <div id="cookieConsentHolder"></div>

    <div class="daily-counter" title="Besucher heute">
        <i class="fa fa-fw fa-clock" aria-hidden="true"></i>
        <span id="dailyVisitors">
            <%= visitorStats.dailyVisitors %>
        </span>
    </div>

    <div class="footer-pun">
        <%- getFooterPun() %>
    </div>

    <div class="dropup sitemap">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-toggle="dropdown" aria-haspopup="true"
                aria-expanded="false">
            <span class="hidden-sm-down">Sitemap</span>
            <i class="fa fa-map-signs"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right">
            <a class="dropdown-item" href="/about"><i class="fa fa-fw fa-users" aria-hidden="true"></i> Über AAU
                Food</a>
            <a class="dropdown-item" href="https://github.com/fafeichter/AAUFood" target="_blank"><i class="fab fa-fw
            fa-github"
                                                                                                     aria-hidden="true"></i>
                GitHub</a>
            <hr>
            <a class="dropdown-item" href="/imprint"><i class="fa fa-fw fa-balance-scale" aria-hidden="true"></i>
                Impressum</a>
        </div>
    </div>
</footer>

<% if(isWinterThemeActive()) { %>
    <canvas id="snowCanvas"></canvas>
<% } %>

<script src="<%= manifest.cookie_consent.js %>"></script>
<script src="<%= manifest.fontawesome.js %>"></script>
<script src="<%= manifest.app.js %>"></script>

<% if(isWinterThemeActive()) { %>
    <script src="<%= manifest.winter_theme.js %>"></script>
<% } %>

</body>
</html>